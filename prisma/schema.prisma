generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ---------------- Enums ----------------
 */

enum MemberStatus {
  LAOBAN
  PEIWAN
}

enum EntryKind {
  DIANDAN
  DASHANG
  TIXIAN
  RECHARGE
}

enum PeiwanStatus {
  busy
  free
}

enum OrderMode {
  REALNAME
  ANONYMOUS
}

enum OrderStatus {
  PENDING
  RUNNING
  ENDED
  DECLINED
  CANCELED
  EXPIRED
}

enum DispatchRequestStatus {
  OPEN
  CLOSED
  EXPIRED
  CANCELED
}

enum DispatchSource {
  DISCORD
  WECHAT_MINIPROGRAM
}

enum DispatchCandidateStatus {
  ACTIVE
  SELECTED
  CANCELED
}

enum MiniConversationType {
  DIRECT
  SYSTEM
  SUPPORT
}

enum MiniMessageSenderType {
  USER
  SYSTEM
  BOT
  ADMIN
}

enum MiniMessageStatus {
  NORMAL
  BLOCKED
  NOTICE
}

enum MiniModerationAction {
  ALLOW
  ALERT
  BLOCK
}

enum MiniAvailabilityStatus {
  AVAILABLE
  BUSY
  RESTING
}

enum AuditionInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  FULFILLED
  CANCELED
}

enum RechargeOrderStatus {
  PENDING
  PAID
  FAILED
}

enum StripePaymentStatus {
  PENDING
  SUCCEEDED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  DISPUTE_CLOSED
  FAILED
  EXPIRED
}

enum WechatNativePaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CLOSED
}

/// Reconciliation of an existing manual platform recharge against the real
/// account which received the money. This ledger deliberately never changes a
/// boss's platform wallet.
enum SettlementReconciliationStatus {
  PENDING_FINANCE
  FINANCE_CONFIRMED
  OWNER_CONFIRMED
  OWNER_DISPUTED
  INVALIDATED
}

enum SettlementTransferStatus {
  PENDING_RECEIVER_CONFIRMATION
  RECEIVER_CONFIRMED
  RECEIVER_DISPUTED
  CANCELED
}

enum SettlementPayoutStatus {
  PAID
  VOIDED
}

enum QuotationCode {
  Q1
  Q2
  Q3
  Q4
  Q5
  Q6
  Q7
  Q8
  Q9
  Q10
}

enum PeiwanSex {
  小姐姐
  小哥哥
}

enum PeiwanType {
  娱乐陪玩
  技术陪玩
  大神陪玩
}

enum PeiwanGameCode {
  LOL
  CSGO
  VAL
  NARAKA
  OW
  APEX
  DELTA
  MARVEL
  TFT
  TARKOV
  DOTA
  COD
  CHAT
  SINGER
}

enum PeiwanGameTier {
  ENTERTAINMENT
  TRAINEE
  TECH
  MASTER
  DEMON_GUARD
}

enum FarmSeedType {
  WHEAT
  ROSE
  KOI_FLOWER
  MYSTERY_FRUIT
}

enum FarmActionType {
  BALANCE_TO_COINS
  POINTS_TO_COINS
  COINS_TO_POINTS
  PLANT
  HARVEST
  EXPAND
  STEAL
}

enum PeiwanLevel {
  优选陪玩
  明星陪玩
  殿堂陪玩
}

enum RedEnvelopeStatus {
  ACTIVE
  FINISHED
  REFUNDED
}

enum LotteryPool {
  NORMAL // 银色
  MEDIUM // 金色
  ADVANCED // 高级（有限）
  SPECIAL // 特级（有限）
}

enum LotteryPrizeType {
  COUPON
  GIFT
  OTHER
  SELFUSE
}

enum AccountProvider {
  DISCORD
  WECHAT_MINIPROGRAM
  WECHAT_WEB
}

enum DlmAdminOperationType {
  MANUAL_WECHAT_BOSS_CREATE
  MANUAL_WECHAT_RECHARGE
  RECHARGE_CASHBACK
  WECHAT_RECHARGE_NOTIFICATION
  DELEGATED_GIFT
  DELEGATED_ORDER
}

enum DlmAdminOperationStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Events that must appear in the member-facing notification center. These are
/// deliberately business events rather than transport-specific records so one
/// event can be delivered to Discord, web push, and email independently.
enum GuildNotificationEvent {
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_CANCELED
  BALANCE_ADJUSTED
}

enum GuildNotificationChannel {
  DISCORD
  WEB_PUSH
  EMAIL
}

enum GuildNotificationDeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

/**
 * ---------------- Models ----------------
 */

model Activity {
  title       String  @id
  description String?
  type        String?
}

model DlmUser {
  dlmId                     String                 @id
  discordUserId             String?                @unique
  discordDisplayName        String?
  discordAvatarUrl          String?
  wechatDisplayName         String?
  wechatAvatarUrl           String?
  sessionVersion            Int                    @default(1)
  totalBalance              Decimal                @default(0) @db.Decimal(19, 4)
  income                    Decimal                @default(0) @db.Decimal(19, 4)
  recharge                  Decimal                @default(0) @db.Decimal(19, 4)
  totalSpent                Decimal                @default(0) @db.Decimal(19, 4)
  loyaltyPoints             Decimal                @default(0) @db.Decimal(19, 4)
  miniAvailability          MiniAvailabilityStatus @default(RESTING)
  miniAvailabilitySetAt     DateTime?
  miniCriticalNotifications Boolean                @default(false)
  miniMessageNotifications  Boolean                @default(false)
  miniDispatchNotifications Boolean                @default(false)
  notificationEmail         String?
  notificationEmailEnabled  Boolean                @default(false)
  withdrawAccount1          String?
  withdrawAccount2          String?
  withdrawAccount3          String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  member                  Member?                 @relation("DlmUserMember", fields: [discordUserId], references: [discordUserId], onDelete: SetNull)
  accountBindings         AccountBinding[]
  authLoginEvents         AuthLoginEvent[]
  wechatProgramSessions   WechatProgramSession[]
  hostedOrders            Order[]
  rechargeOrders          ZPayRechargeOrder[]
  stripePayments          StripePayment[]
  wechatNativePayments    WechatNativePayment[]
  rechargeRecords         Recharge[]
  withdrawals             Withdraw[]
  individualTransactions  IndividualTransaction[]
  coupons                 Coupon[]
  loyaltyPoint            LoyaltyPoint?
  withdrawalAccount       WithdrawalAccount?
  lotteryDraws            LotteryDraw[]
  lotteryPity             LotteryPity?
  pointShopCarts          PointShopCart[]
  pointShopOrders         PointShopOrder[]
  pointShopGrants         PointShopGrant[]
  pointShopPointLedgers   PointShopPointLedger[]
  consumedCoupons         Coupon[]                @relation("CouponConsumeTargetDlmUser")
  consumedLotteryDraws    LotteryDraw[]           @relation("LotteryConsumeTargetDlmUser")
  consumedPointShopGrants PointShopGrant[]        @relation("PointShopGrantConsumeTargetDlmUser")
  sentTransactions        Transaction[]           @relation("TransactionFromDlmUser")
  receivedTransactions    Transaction[]           @relation("TransactionToDlmUser")
  commissionsFrom         Commission[]            @relation("CommissionFromDlmUser")
  commissionsTo           Commission[]            @relation("CommissionToDlmUser")
  dispatchRequests        DispatchRequest[]       @relation("DispatchRequestOwner")
  dispatchCandidates      DispatchCandidate[]     @relation("DispatchCandidateWorker")
  miniConversationsA      MiniConversation[]      @relation("MiniConversationUserA")
  miniConversationsB      MiniConversation[]      @relation("MiniConversationUserB")
  miniMessages            MiniMessage[]           @relation("MiniMessageSender")
  openingBenefitClaims    OpeningBenefitClaim[]
  manualWechatBoss        ManualWechatBoss?
  adminOperations         DlmAdminOperation[]
  guildNotifications      GuildNotification[]
  webPushSubscriptions    WebPushSubscription[]
}

/// A boss account created and maintained by staff for offline WeChat payments.
/// It intentionally has no login secret: the DLM-ID portal is read-only.
model ManualWechatBoss {
  dlmId              String   @id
  wechatContact      String   @unique
  displayName        String?
  createdByDiscordId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dlmUser DlmUser @relation(fields: [dlmId], references: [dlmId], onDelete: Cascade)

  @@index([createdByDiscordId, createdAt])
}

/// Immutable intent/result trail for staff actions affecting a DLM-only boss.
/// requestId makes calls from the admin UI idempotent.
model DlmAdminOperation {
  id                String                  @id @default(cuid())
  requestId         String                  @unique
  // Manual WeChat recharge receiving account (for example, "iria支付宝").
  // Accounts can receive many payments, so this is deliberately not unique.
  receiptReference  String?
  sourceOperationId String?                 @unique
  dlmId             String
  operatorDiscordId String
  type              DlmAdminOperationType
  status            DlmAdminOperationStatus @default(PENDING)
  details           Json?
  result            Json?
  failureReason     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  dlmUser DlmUser @relation(fields: [dlmId], references: [dlmId], onDelete: Cascade)

  @@index([dlmId, createdAt])
  @@index([receiptReference, createdAt])
  @@index([operatorDiscordId, createdAt])
  @@index([type, status, createdAt])
}

model AccountBinding {
  id             String          @id @default(cuid())
  dlmId          String
  provider       AccountProvider
  providerUserId String
  unionId        String?
  profile        Json?
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  dlmUser               DlmUser                @relation(fields: [dlmId], references: [dlmId], onDelete: Cascade)
  wechatProgramSessions WechatProgramSession[]

  @@unique([provider, providerUserId])
  @@index([dlmId])
  @@index([provider, unionId])
}

model AuthLoginEvent {
  id                 String          @id @default(cuid())
  dlmId              String?
  discordUserId      String?
  provider           AccountProvider
  ipAddressEncrypted String?
  ipHash             String?
  ipCountry          String?
  ipRegion           String?
  ipCity             String?
  userAgent          String?
  referrer           String?
  visitorId          String?
  createdAt          DateTime        @default(now())

  dlmUser DlmUser? @relation(fields: [dlmId], references: [dlmId], onDelete: SetNull)
  member  Member?  @relation(fields: [discordUserId], references: [discordUserId], onDelete: SetNull, onUpdate: Cascade)

  @@index([dlmId, createdAt])
  @@index([discordUserId, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

model WechatProgramSession {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  dlmId             String
  providerAccountId String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?

  dlmUser         DlmUser         @relation(fields: [dlmId], references: [dlmId], onDelete: Cascade)
  providerAccount AccountBinding? @relation(fields: [providerAccountId], references: [id], onDelete: SetNull)

  @@index([dlmId, expiresAt])
}

/// A browser-owned subscription endpoint. The private VAPID key never enters
/// this table; it remains server-only in the deployment environment.
model WebPushSubscription {
  id             String    @id @default(cuid())
  dlmId          String
  endpoint       String    @unique @db.Text
  p256dh         String    @db.Text
  auth           String    @db.Text
  expirationTime DateTime?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  dlmUser DlmUser @relation(fields: [dlmId], references: [dlmId], onDelete: Cascade)

  @@index([dlmId, updatedAt])
}

/// The durable, in-app record for an operational event. `dedupeKey` lets a
/// retrying Bot or web worker safely submit the same event more than once.
model GuildNotification {
  id        String                 @id @default(cuid())
  dlmId     String
  event     GuildNotificationEvent
  title     String                 @db.VarChar(160)
  body      String                 @db.VarChar(1000)
  href      String?                @db.VarChar(512)
  details   Json?
  dedupeKey String?                @unique
  readAt    DateTime?
  createdAt DateTime               @default(now())

  dlmUser    DlmUser                     @relation(fields: [dlmId], references: [dlmId], onDelete: Cascade)
  deliveries GuildNotificationDelivery[]

  @@index([dlmId, createdAt])
  @@index([dlmId, readAt, createdAt])
  @@index([event, createdAt])
}

model GuildNotificationDelivery {
  id             String                          @id @default(cuid())
  notificationId String
  channel        GuildNotificationChannel
  status         GuildNotificationDeliveryStatus @default(PENDING)
  attempts       Int                             @default(0)
  error          String?                         @db.VarChar(1000)
  sentAt         DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  notification GuildNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, updatedAt])
}

model DiscordMigrationAudit {
  id                String   @id @default(cuid())
  operatorDiscordId String?
  oldDiscordId      String
  newDiscordId      String
  archiveDiscordId  String?
  sourceDlmId       String?
  forceTakeover     Boolean  @default(false)
  takeoverSnapshot  Json?
  changed           Json?
  createdAt         DateTime @default(now())

  @@index([oldDiscordId, createdAt])
  @@index([newDiscordId, createdAt])
  @@index([createdAt])
}

/// Immutable, per-run source-server Role snapshot used only for the Discord
/// server migration. It deliberately has no relation to Member because users
/// who have never used the platform can still need their Role restored.
model DiscordRoleMigrationSnapshot {
  id            String                               @id @default(cuid())
  sourceGuildId String
  targetGuildId String
  capturedAt    DateTime                             @default(now())
  createdAt     DateTime                             @default(now())
  members       DiscordRoleMigrationSnapshotMember[]

  @@index([sourceGuildId, targetGuildId, capturedAt])
}

/// The complete non-everyone Role ID set held by one source-guild member at
/// the moment a DiscordRoleMigrationSnapshot was captured.
model DiscordRoleMigrationSnapshotMember {
  id            String                       @id @default(cuid())
  snapshotId    String
  discordUserId String
  roleIds       String[]                     @default([])
  createdAt     DateTime                     @default(now())
  snapshot      DiscordRoleMigrationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, discordUserId])
  @@index([discordUserId])
}

model AssetTransferAudit {
  id                String   @id @default(cuid())
  operatorDiscordId String?
  sourceDiscordId   String
  targetDiscordId   String
  sourceDlmId       String?
  targetDlmId       String?
  forceMerge        Boolean  @default(false)
  sourceSnapshot    Json?
  targetSnapshot    Json?
  transferred       Json?
  changed           Json?
  warnings          Json?
  createdAt         DateTime @default(now())

  @@index([sourceDiscordId, createdAt])
  @@index([targetDiscordId, createdAt])
  @@index([createdAt])
}

model Member {
  // Primary key is the Discord user id
  discordUserId String       @id
  status        MemberStatus @default(LAOBAN)

  // Money
  totalBalance Decimal @default(0) @db.Decimal(19, 4)
  income       Decimal @default(0) @db.Decimal(19, 4)
  recharge     Decimal @default(0) @db.Decimal(19, 4)
  totalSpent   Decimal @default(0) @db.Decimal(19, 4)

  // Payout rate (user receives this share of gross), default 75%
  commissionRate     Decimal @default(0.75) @db.Decimal(7, 6)
  // Original payout share baseline, used when temporary boosts expire
  baseCommissionRate Decimal @default(0.75) @db.Decimal(7, 6)

  // Relations
  commissionFrom Commission[]    @relation("CommissionFrom")
  commissionTo   Commission[]    @relation("CommissionTo")
  dailySnapshots DailySnapshot[]

  sentTransactions     Transaction[]         @relation("FromMember")
  receivedTransactions Transaction[]         @relation("ToMember")
  zpayRechargeOrders   ZPayRechargeOrder[]
  stripePayments       StripePayment[]
  wechatNativePayments WechatNativePayment[]
  authLoginEvents      AuthLoginEvent[]

  // One-to-one: every 陪玩 is a member; not every member is a 陪玩
  peiwan            PEIWAN?            @relation("MemberToPeiwan")
  // Loyalty points (one-to-one)
  loyaltyPoint      LoyaltyPoint?
  // Farm profile (one-to-one)
  farmProfile       FarmProfile?
  // Withdrawal account presets (one-to-one)
  withdrawalAccount WithdrawalAccount?

  // Orders (reverse edges)
  ordersAsHost   Order[] @relation("HostOrders")
  ordersAsWorker Order[] @relation("WorkerOrders")

  // Heart counters (from → to)
  heartFrom HeartCounter[] @relation("HeartFrom")
  heartTo   HeartCounter[] @relation("HeartTo")

  // Lottery draws
  lotteryDraws           LotteryDraw[]
  lotteryPity            LotteryPity?
  scratchTickets         ScratchTicket[]        @relation("ScratchTicketOwner")
  pointShopCarts         PointShopCart[]
  pointShopOrders        PointShopOrder[]
  pointShopPointLedgers  PointShopPointLedger[]
  pointShopGrants        PointShopGrant[]       @relation("PointShopGrantOwner")
  pointShopGrantConsumes PointShopGrant[]       @relation("PointShopGrantConsumeTarget")
  blacklistsCreated      Blacklist[]            @relation("BlacklistBlocker")
  blacklistedBy          Blacklist[]            @relation("BlacklistBlocked")
  vipBenefitGrants       VipBenefitGrant[]
  vipBenefitProfile      VipBenefitProfile?
  authoredPeiwanReviews  PeiwanReview[]         @relation("PeiwanReviewReviewer")
  receivedPeiwanReviews  PeiwanReview[]         @relation("PeiwanReviewPeiwan")
  voicePointSessions     VoicePointSession[]
  voicePointLedgers      VoicePointLedger[]
  pageViewEvents         PageViewEvent[]

  // Gift wall unlocks/rewards
  giftUnlocks      PeiwanGiftUnlock[]
  giftRewardClaims PeiwanGiftRewardClaim[]

  // Back-relation for WorkerLock (one active lock at most)
  workerLock WorkerLock? @relation("MemberWorkerLock")

  // Invite link reward records
  inviteRewardsGiven    InviteLinkUsage[] @relation("MemberToInviteLinkUsage")
  inviteRewardsReceived InviteLinkUsage[] @relation("InviteeToInviteLinkUsage")

  // Referral relations
  referralInviter Referral[] @relation("ReferralInviter")
  referralInvitee Referral?  @relation("ReferralInvitee")

  // Display name inside target Discord guild
  serverDisplayName String?
  // Immutable-style Discord handle (the current username, without @).
  discordUsername   String?

  // Optional app-level identity shared by web and mini program clients.
  dlmUser DlmUser? @relation("DlmUserMember")

  // Order request logs/clicks
  orderRequestsCreated          OrderRequestLog[]   @relation("OrderRequestOwner")
  orderRequestClicks            OrderRequestClick[] @relation("OrderRequestWorker")
  dispatchRequestsFromDiscord   DispatchRequest[]   @relation("DispatchRequestDiscordOwner")
  dispatchCandidatesFromDiscord DispatchCandidate[] @relation("DispatchCandidateDiscordWorker")
  bossProfile                   BossProfile?
  auditionRoom                  AuditionRoom?       @relation("BossAuditionRoom")
  bossAuditionInvites           AuditionInvite[]    @relation("BossAuditionInvites")
  workerAuditionInvites         AuditionInvite[]    @relation("WorkerAuditionInvites")

  // Expense & profit logs
  expensesAsOperator            Expense[]              @relation("ExpenseOperator")
  expensesAsTarget              Expense[]              @relation("ExpenseTarget")
  monthlyManualExpensesAsEditor MonthlyManualExpense[] @relation("MonthlyManualExpenseEditor")
  profitsAsOperator             PureProfit[]           @relation("PureProfitOperator")
  profitsAsTarget               PureProfit[]           @relation("PureProfitTarget")
  couponsAsConsumeTarget        Coupon[]               @relation("CouponConsumeTarget")
  lotteryConsumeTargets         LotteryDraw[]          @relation("LotteryConsumeTarget")
}

model Blacklist {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Member @relation("BlacklistBlocker", fields: [blockerId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  blocked Member @relation("BlacklistBlocked", fields: [blockedId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId, createdAt])
  @@map("blacklist")
}

model LoyaltyPoint {
  discordUserId String   @id
  dlmId         String?  @unique
  points        Decimal  @default(0) @db.Decimal(19, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member  Member   @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)
  dlmUser DlmUser? @relation(fields: [dlmId], references: [dlmId], onDelete: SetNull)
}

model FarmProfile {
  discordUserId String   @id
  coins         Decimal  @default(0) @db.Decimal(19, 4)
  experience    Int      @default(0)
  unlockedPlots Int      @default(4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member          @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)
  plots  FarmPlot[]
  logs   FarmActionLog[]
}

model FarmPlot {
  id            String        @id @default(cuid())
  discordUserId String
  plotIndex     Int
  seedType      FarmSeedType?
  plantedAt     DateTime?
  readyAt       DateTime?
  lastStolenAt  DateTime?
  lastStolenBy  String?
  stolenCoins   Decimal       @default(0) @db.Decimal(19, 4)
  lastHarvestAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile FarmProfile @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)

  @@unique([discordUserId, plotIndex])
  @@index([discordUserId, readyAt])
}

model FarmActionLog {
  id            String         @id @default(cuid())
  discordUserId String
  actionType    FarmActionType
  plotIndex     Int?
  seedType      FarmSeedType?
  balanceDelta  Decimal        @default(0) @db.Decimal(19, 4)
  pointDelta    Decimal        @default(0) @db.Decimal(19, 4)
  coinDelta     Decimal        @default(0) @db.Decimal(19, 4)
  expDelta      Int            @default(0)
  note          String?
  createdAt     DateTime       @default(now())

  profile FarmProfile @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)

  @@index([discordUserId, createdAt])
  @@index([discordUserId, actionType, createdAt])
}

model FarmVisit {
  id              String   @id @default(cuid())
  viewerDiscordId String
  targetDiscordId String
  visitCount      Int      @default(1)
  createdAt       DateTime @default(now())
  lastVisitedAt   DateTime @default(now())

  @@unique([viewerDiscordId, targetDiscordId])
  @@index([viewerDiscordId, lastVisitedAt])
  @@index([viewerDiscordId, visitCount])
}

model VoicePointSession {
  id              String    @id @default(cuid())
  discordUserId   String
  guildId         String
  channelId       String
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  eligibleSeconds Int       @default(0)
  pointsAwarded   Decimal   @default(0) @db.Decimal(19, 4)
  closeReason     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  member Member            @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  ledger VoicePointLedger?

  @@index([discordUserId, joinedAt])
  @@index([discordUserId, leftAt])
  @@index([guildId, channelId, joinedAt])
}

model VoicePointLedger {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  discordUserId   String
  guildId         String
  channelId       String
  durationSeconds Int
  points          Decimal  @db.Decimal(19, 4)
  ruleVersion     String?
  createdAt       DateTime @default(now())

  member  Member            @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  session VoicePointSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([discordUserId, createdAt])
  @@index([guildId, channelId, createdAt])
}

model PageViewEvent {
  id            String   @id @default(cuid())
  path          String
  visitorId     String
  discordUserId String?
  referrer      String?
  userAgent     String?
  createdAt     DateTime @default(now())

  member Member? @relation(fields: [discordUserId], references: [discordUserId], onDelete: SetNull, onUpdate: Cascade)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
  @@index([discordUserId, createdAt])
}

model Transaction {
  Transid   String   @id @default(cuid())
  orderID   Int      @unique @default(autoincrement())
  fromId    String?
  toId      String
  fromDlmId String?
  toDlmId   String?
  amount    Decimal  @db.Decimal(19, 4)
  feeAmount Decimal  @db.Decimal(19, 4)
  netAmount Decimal  @db.Decimal(19, 4)
  createdAt DateTime @default(now())

  commissionById    Commission?     @relation("commissionById")
  commissionByOrder Commission?     @relation("commissionByOrder")
  auditionInvite    AuditionInvite?

